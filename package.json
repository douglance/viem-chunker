{
  "name": "viem-chunker",
  "version": "0.0.1",
  "description": "Chunked, retrying block range actions for viem clients.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/douglance/viem-chunker.git"
  },
  "packageManager": "pnpm@11.2.2",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "format": "biome format --write .",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:types": "tsd",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:types && pnpm build && publint"
  },
  "peerDependencies": {
    "viem": ">=2.51.3 <3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@changesets/cli": "^2.29.7",
    "@types/node": "^24.10.1",
    "fast-check": "^4.3.0",
    "publint": "^0.3.15",
    "tsd": "^0.33.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "viem": "^2.51.3",
    "vitest": "^4.0.14"
  }
}
